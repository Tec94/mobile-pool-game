{
  // The waitlist site: static page in public/, one endpoint (worker.js) that stores signups in D1. No email is sent.
  "name": "runout-waitlist",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // run_worker_first: every request passes worker.js so www and workers.dev can redirect to runout.win.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "runout.win", "custom_domain": true }, { "pattern": "www.runout.win", "custom_domain": true }],
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "runout-waitlist", "database_id": "aa62e36e-f59a-492a-b17f-abad799fcdf0" }],
  // Five signups a minute from one address (worker.js). namespace_id is any number not used by another limiter in the account.
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "2601", "simple": { "limit": 5, "period": 60 } }],
  "build": { "command": "npm run build" },
  // "off" skips the Turnstile check in worker.js. To turn it back on: delete this line and put the widget back in public/index.html.
  "vars": { "TURNSTILE": "off" },
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
